{
  "manifest_version": 3,
  "name": "Board App Extension",
  "description": "Extended start page with improved search functionality and better organization of shortcuts to increase your productivity.",
  "version": "2.0.0",
  "author": {
    "email": "hello@coredata.pl"
  },
  "icons": {
    "16": "img/icons/symbol64.png",
    "32": "img/icons/symbol64.png",
    "48": "img/icons/symbol64.png",
    "128": "img/icons/symbol128.png",
    "192": "img/icons/symbol192.png",
    "256": "img/icons/symbol256.png",
    "512": "img/icons/symbol512.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "geolocation",
    "microphone",
    "storage"
  ]
}